{
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH, HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ]
}
